FROM registry.access.redhat.com/ubi9/openjdk-17-runtime:1.24-3.1794341131

USER 0
WORKDIR /config
RUN chmod 0775 /config
VOLUME ["/config"]
WORKDIR /opt/app
COPY --chown=0:0 --chmod=0444 build/libs/sodata-*-exec.jar ./application.jar

USER 1001:0
EXPOSE 8080
ENV HOME=/opt/app LOG4J_FORMAT_MSG_NO_LOOKUPS=true
CMD ["java", "-XX:MaxRAMPercentage=80.0", "-jar", "application.jar"]
